# Ignores node_modules in the main folder AND in all subfolders
**/node_modules/

# Ignores build outputs across all subfolders
**/dist/
**/build/

# Ignores secret/environment files
**/.env
**/.env.local

# Ignores log files
*.log
npm-debug.log*

# Ignores operating system hidden files
.DS_Store
Thumbs.db